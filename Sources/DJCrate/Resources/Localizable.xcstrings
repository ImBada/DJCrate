            "value" : "Couldn't read the bar range '%@'. Enter it as first bar-last bar, like 1-16"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小節範囲「%@」を読み取れませんでした。1-16のように最初の小節-最後の小節で入力してください"
          }
        }
      }
    },
    "마디 구간 %lld-%lld이 거꾸로입니다. 앞 마디를 먼저 쓰세요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bar range %lld-%lld is reversed. Put the earlier bar first"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小節範囲%lld-%lldが逆になっています。前の小節を先に入力してください"
