    },
    "rekordbox에 쓰는 규칙을 아직 확인하지 않은 칸(%@)이 있습니다. 그 칸을 되돌리면 나머지는 쓸 수 있습니다" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some fields (%@) have rekordbox write rules that DJCrate hasn't verified yet. Revert those fields to write the rest."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rekordboxへの書き込み規則をまだ確認していない項目（%@）があります。その項目を元に戻すと残りは書き込めます"
          }
        }
      }
    },
