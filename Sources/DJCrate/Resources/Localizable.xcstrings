          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rekordboxライブラリを読み込み中…"
          }
        }
      }
    },
    "곡 목록을 준비하는 중…" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preparing the track list…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲一覧を準備中…"
          }
        }
      }
    },
    "쓴 라이브러리를 다시 읽는 중…" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reloading the updated library…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き込み後のライブラリを再読み込み中…"
          }
        }
      }
    },
    "결과" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Result"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結果"
          }
        }
      }
    },
    "결과 재생" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play Result"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結果を再生"
          }
        }
      }
    },
    "결과 재생선에서 가장 가까운 마디 줄로 클립을 둘로 나눕니다(⌘B)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Splits the clip in two at the bar line nearest the result playhead (⌘B)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結果の再生ヘッドに最も近い小節線でクリップを2つに分割します（⌘B）。"
          }
        }
      }
    },
    "결과에 넣기" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add to Result"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結果に追加"
          }
        }
      }
    },
    "고른 구간 마디 %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selected bars %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した区間：小節%@"
          }
        }
      }
    },
    "고른 구간 마디 %@ · %@ + 곡 머리 · %@–%@" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "고른 구간 마디 %1$@ · %2$@ + 곡 머리 · %3$@–%4$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selected bars %1$@ · %2$@ + lead-in · %3$@–%4$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した区間：小節%1$@ · %2$@ + 曲頭 · %3$@–%4$@"
          }
        }
      }
    },
    "고른 구간 마디 %@ · %@ · %@–%@" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "고른 구간 마디 %1$@ · %2$@ · %3$@–%4$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selected bars %1$@ · %2$@ · %3$@–%4$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した区間：小節%1$@ · %2$@ · %3$@–%4$@"
          }
        }
      }
    },
    "고른 구간 없음" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No bars selected"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "区間の選択なし"
          }
        }
      }
    },
    "고른 구간을 결과의 고른 클립 뒤(없으면 끝)에 넣습니다(⏎). 맨 앞에 넣을 때만 곡 머리(0마디)를 살립니다" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds the selected bars after the selected clip in the result, or at the end if no clip is selected (⏎). The lead-in (bar 0) is kept only when added at the very beginning."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した区間を結果の選択中のクリップの後ろ（なければ最後）に追加します（⏎）。曲頭（0小節）は先頭に追加するときだけ残します。"
          }
        }
      }
    },
    "고른 클립 바로 뒤에 같은 구간을 하나 더 둡니다(⌘D). 인트로를 늘일 때 씁니다" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Places another copy of the selected clip right after it (⌘D). Use this to extend an intro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択中のクリップのすぐ後ろに同じ区間をもう1つ置きます（⌘D）。イントロを延ばすときに使います。"
          }
        }
      }
    },
    "고른 클립을 결과에서 뺍니다(⌫)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes the selected clip from the result (⌫)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択中のクリップを結果から外します（⌫）。"
          }
        }
      }
    },
    "곡 머리(0마디)는 결과 맨 앞에만 둘 수 있습니다. 1마디 이상을 함께 고르세요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lead-in (bar 0) can only be at the very beginning of the result. Select at least one bar along with it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲頭（0小節）は結果の先頭にしか置けません。1小節以上を一緒に選んでください。"
          }
        }
      }
    },
    "구간 넣기" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add Segment"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "区間の追加"
          }
        }
      }
    },
    "끌어서 마디 구간을 고르고, 눌러서 재생선을 옮깁니다" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag to select bars; click to move the playhead."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグで小節区間を選び、クリックで再生ヘッドを移動します。"
          }
        }
      }
    },
    "마디 고치기" : {
