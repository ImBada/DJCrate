          }
        }
      }
    },
    "마디 %lld은 곡 끝을 넘습니다. 마지막 마디 %lld 이하로 고르세요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bar %lld is past the end of the track. Choose bar %lld or earlier"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld小節目は曲の終わりを超えています。最後の小節%lld以前を選んでください"
