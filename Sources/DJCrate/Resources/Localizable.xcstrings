        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reading the iTunes playlist snapshot…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTunesプレイリストのスナップショットを読み込み中…"
