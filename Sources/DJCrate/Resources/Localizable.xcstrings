    "  %@\t%@\t%@\t신뢰도 %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  %1$@\t%2$@\t%3$@\tConfidence %4$@"
          }
        },
